generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  analyses      Analysis[]
  bookmarks     Bookmark[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Analysis {
  id             String   @id @default(cuid())
  userId         String
  sourceUrl      String?
  textContent    String?
  verdict        String
  confidence     Float
  scoreBreakdown String?
  summary        String
  claims         Claim[]
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Claim {
  id         String   @id @default(cuid())
  analysisId String
  claimText  String
  verdict    String
  evidence   Evidence[]

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

model Evidence {
  id          String @id @default(cuid())
  claimId     String
  sourceUrl   String
  title       String
  snippet     String
  credibility String

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  analysisId String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
