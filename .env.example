# Database (Supabase Session Pooler & Direct Connection)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_DB_PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_DB_PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require"

# APIs
NVIDIA_API_KEY="[YOUR_NVIDIA_API_KEY]"
GNEWS_API_KEY="[YOUR_GNEWS_API_KEY]"

# Supabase
# NOTE: this file is committed to git — never put real keys here, including
# the service-role key below (it bypasses all database security). Put real
# values in .env.local instead, which is gitignored.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR_SUPABASE_ANON_KEY]"
# Newer Supabase projects may label this key "publishable" instead of "anon" —
# either name works, src/lib/supabase/config.ts accepts both.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="[YOUR_SUPABASE_PUBLISHABLE_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR_SUPABASE_SERVICE_ROLE_KEY]"

# Scraper behavior (optional)
# Set to "false" to disable the robots.txt compliance check. Defaults to respected.
RESPECT_ROBOTS_TXT="true"

# Admin access (optional)
# Comma-separated list of email addresses allowed to view /admin/abuse.
ADMIN_EMAILS="you@example.com"
